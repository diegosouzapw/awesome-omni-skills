---
import { Image } from 'astro:assets';
import hero from '../assets/hero.jpg';
import cardImage from '../assets/card.jpg';
---

<!-- Likely LCP image: above the fold, eager, high priority -->
<Image
  src={hero}
  alt="Hero banner"
  widths={[640, 960, 1280]}
  sizes="(max-width: 768px) 100vw, 1280px"
  format="webp"
  loading="eager"
  fetchpriority="high"
/>

<!-- Below-the-fold image: normal lazy behavior is acceptable -->
<Image
  src={cardImage}
  alt="Article card image"
  widths={[320, 480, 640]}
  sizes="(max-width: 768px) 50vw, 320px"
  format="webp"
/>
