{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifierSubagentOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "verified_claims",
    "unverified_or_failed_claims",
    "evidence",
    "escalation_needed"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "partial", "fail", "needs_more_context"]
    },
    "summary": {
      "type": "string"
    },
    "verified_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unverified_or_failed_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escalation_needed": {
      "type": "boolean"
    },
    "approval_required": {
      "type": "boolean"
    }
  }
}
