{
  "schema_version": "2026-03-27",
  "skill_id": "documentation-v2",
  "document_types": {
    "readme": {
      "purpose": "repository entry point and quickstart",
      "source_of_truth": [
        "repository structure",
        "current setup commands",
        "runtime or package requirements"
      ],
      "validation_targets": [
        "prerequisites are explicit",
        "commands and paths exist",
        "expected first-success path is current"
      ]
    },
    "api_reference": {
      "purpose": "precise interface description",
      "source_of_truth": [
        "OpenAPI specification",
        "schema definitions",
        "code annotations",
        "generator inputs"
      ],
      "validation_targets": [
        "required fields match schema",
        "examples are valid",
        "auth and error semantics are documented",
        "generated and authored content do not conflict"
      ]
    },
    "architecture_overview": {
      "purpose": "system structure and major flows",
      "source_of_truth": [
        "current implementation boundaries",
        "deployment manifests",
        "active diagrams",
        "decision records"
      ],
      "validation_targets": [
        "components and flows are current",
        "diagrams and text agree",
        "operational consequences are explained"
      ]
    },
    "adr": {
      "purpose": "record a decision and consequences",
      "source_of_truth": [
        "engineering decision record",
        "related implementation change",
        "linked architecture context"
      ],
      "validation_targets": [
        "decision is explicit",
        "alternatives are noted",
        "consequences are honest and traceable"
      ]
    },
    "generated_docs": {
      "purpose": "publish reproducible reference output",
      "source_of_truth": [
        "generator configuration",
        "OpenAPI files",
        "annotations",
        "schema sources"
      ],
      "validation_targets": [
        "output is reproducible",
        "manual edits are avoided or clearly allowed",
        "source location is discoverable"
      ]
    }
  }
}
